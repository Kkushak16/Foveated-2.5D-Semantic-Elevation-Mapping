<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>foveated_grid_bridge</name>
  <version>1.0.0</version>
  <description>
    ROS 2 bridge node that subscribes to LiDAR PointCloud2 topics and feeds
    point clouds into the Foveated 2.5D Grid Engine for real-time 3-ring
    elevation mapping.
  </description>
  <maintainer email="kushak16@example.com">Kushak</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
